# Copy to .env and fill in locally. NEVER commit the real .env.
# The local vision prototype needs NONE of these — it runs fully offline.

# --- Environment ---
ENVIRONMENT=dev

# --- AWS (only needed once you wire up cloud reasoning / storage) ---
AWS_REGION=eu-west-2
S3_BUCKET=
AWS_DEPLOY_ROLE_ARN=

# --- Bedrock (cloud reasoning) ---
BEDROCK_MODEL_ID=

# --- Multi-tenant dev placeholder ---
TENANT_ID=dev-tenant-0001

# --- Optional: only if you ever call the Anthropic API directly instead of Bedrock ---
# ANTHROPIC_API_KEY=
